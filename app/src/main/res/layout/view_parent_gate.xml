<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_parent_gate"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="20dp">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/surface"
        app:cardCornerRadius="24dp"
        app:cardElevation="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="26dp">

            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:contentDescription="Proteção dos Pais"
                android:src="@drawable/ic_parents"
                app:tint="@color/primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Acesso dos Pais e Responsáveis"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Para segurança da criança, resolva este cálculo matemático avançado. A conta muda a cada tentativa:"
                android:textAlignment="center"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <!-- Math Question Challenge Box -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card_rounded"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tv_parent_gate_question"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quanto é 47 × 8 ?"
                    android:textColor="@color/primary"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <!-- Refresh math problem button: High contrast vivid color with white bold text -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_parent_gate_refresh"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="@color/secondary"
                    android:text="Gerar Outra Conta 🔄"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="22dp" />
            </LinearLayout>

            <EditText
                android:id="@+id/et_parent_gate_answer"
                android:layout_width="170dp"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_input_field"
                android:gravity="center"
                android:hint="Sua resposta"
                android:inputType="number"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_parent_gate_error"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Resposta incorreta! Nova conta gerada."
                android:textAlignment="center"
                android:textColor="@color/error"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Unlock Button: Deep Blue with white bold text -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_parent_gate_unlock"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:backgroundTint="@color/primary"
                android:text="Confirmar e Entrar"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="26dp" />

            <!-- Cancel Button -->
            <Button
                android:id="@+id/btn_parent_gate_cancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@android:color/transparent"
                android:text="Voltar para o Menu"
                android:textAllCaps="false"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>
